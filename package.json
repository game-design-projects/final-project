{
  "name": "jev-game-ai",
  "version": "0.2.1",
  "private": true,
  "description": "Donjon: a Wizardry-style dungeon crawler whose monsters are driven by Jev (TypeSafe System One).",
  "type": "module",
  "scripts": {
    "crawler": "node crawler/server.js",
    "crawler:scenarios": "node crawler/scripts/scenarios.js",
    "crawler:itch": "node crawler/scripts/build-itch.js",
    "test": "node --test crawler/test/*.test.js",
    "crawler:mock": "JEV_MOCK=1 node crawler/server.js",
    "crawler:social": "node crawler/scripts/social-scenarios.js",
    "crawler:shots": "node crawler/scripts/shots.mjs",
    "crawler:bench": "node crawler/scripts/bench-view.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "playwright-core": "^1.56.1",
    "wrangler": "^4.145.0"
  }
}
